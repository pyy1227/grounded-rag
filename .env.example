# 复制为 .env 后填入真实 key：cp .env.example .env
# .env 已被 .gitignore 忽略，不会进版本库；.env.example 可以安全提交。

# 对话模型（config.toml 的 [llm].api_key_env）
DEEPSEEK_API_KEY=sk-在这里填-deepseek-key

# 向量模型（config.toml 的 [embedding].api_key_env）
DASHSCOPE_API_KEY=sk-在这里填-dashscope-key

# 可选：换分词器，需要先 pip install -e ".[zh]"
# RAGAGENT_TOKENIZER=jieba

# 可选：HTTP 服务使用的配置文件（ragagent serve 也认 --config）
# RAGAGENT_CONFIG=config.toml

# 可选：HTTP 安全边界（详见 README「HTTP 安全边界」）
# 设置 token 后 /ingest、/eval 需要 X-API-Token 或 Authorization: Bearer
# RAGAGENT_API_TOKEN=
# RAGAGENT_INGEST_ROOT=data/docs
# RAGAGENT_EVAL_ROOT=data/eval
# RAGAGENT_REPORT_ROOT=reports
